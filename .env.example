# ─────────────────────────────────────────────────────────────────────────────
# conversor.io — template de variáveis de ambiente.
# Copie para `.env.local` e preencha. NUNCA versione `.env.local` (segredos).
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
APP_URL=http://localhost:3000          # prod: https://conversor.io

# ── Firebase Client (públicas, expostas no browser) ──────────────────────────
# Firebase Console → Project settings → General → Your apps → SDK setup and config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (server only — NUNCA expor) ───────────────────────────────
# Firebase Console → Project settings → Service accounts → Generate new private key
# A private key é multilinha: cole entre aspas com os \n escapados (o app converte).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Conversão ────────────────────────────────────────────────────────────────
# Ativo: limite de documentos/dados, em MB. Opcional; default 4 (abaixo do teto de
# ~4.5 MB do body de função serverless da Vercel). Suba só em self-host/Vercel Pro.
MAX_DOCUMENT_SIZE_MB=4
# Vídeo é convertido no navegador (ffmpeg.wasm); limites abaixo são constantes no código.
MAX_VIDEO_SIZE_MB=100
MAX_VIDEO_DURATION_MIN=15
# Fases seguintes (storage/TTL — ainda não implementado):
TEMP_FILE_TTL_MINUTES=60

# ── Feature flags ────────────────────────────────────────────────────────────
ENABLE_VIDEO_CONVERSION=true
ENABLE_TRANSCRIPTION=false
